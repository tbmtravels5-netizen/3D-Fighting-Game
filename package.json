{
  "name": "arena-masters",
  "version": "1.0.0",
  "description": "Commercial-grade 3D fighting game with multiplayer support",
  "main": "src/index.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "deploy": "npm run build && npm run test",
    "start": "node server.js",
    "analyze": "webpack-bundle-analyzer dist/bundle.js"
  },
  "keywords": [
    "fighting",
    "game",
    "3d",
    "multiplayer",
    "competitive",
    "arena",
    "combat"
  ],
  "author": "tbmtravels5-netizen",
  "license": "MIT",
  "dependencies": {
    "three": "^r128",
    "cannon-es": "^0.20.0",
    "gsap": "^3.12.0",
    "socket.io-client": "^4.5.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "eslint": "^8.44.0",
    "jest": "^29.6.0",
    "babel-jest": "^29.6.0",
    "compression-webpack-plugin": "^10.2.0",
    "copy-webpack-plugin": "^11.0.0",
    "style-loader": "^3.3.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
